{
  "name": "helpdesk-360-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,cyan.bold\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "db:setup": "npm run db:setup -w backend",
    "db:seed": "npm run db:seed -w backend",
    "test": "npm run test -w backend",
    "test:e2e": "npm run test -w tests",
    "screenshots": "npm run screenshots -w tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
