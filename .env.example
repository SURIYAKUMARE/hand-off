# Environment Configuration for HelpDesk 360

# Application Port
PORT=4000

# Environment Mode: development | production | test
NODE_ENV=development

# Database Connection String
# For local SQLite persistence:
DATABASE_URL="file:./dev.db"

# For Docker / Production PostgreSQL:
# DATABASE_URL="postgresql://helpdesk_user:helpdesk_secure_password@localhost:5432/helpdesk360?schema=public"

# Session Security Secret
SESSION_SECRET="helpdesk360_enterprise_secure_cookie_session_secret_key_2026"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"
